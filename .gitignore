# ---------------------------------------------------------------
# Drone Simulation — root .gitignore
# Covers backend/ (NestJS) and frontend/ (React + Vite) workspaces.
# ---------------------------------------------------------------

# Dependencies
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Build outputs
dist/
build/
out/
*.tsbuildinfo

# Environment files — never commit secrets.
# Only the committed templates (.env.example) are allowed.
.env
.env.*
!.env.example

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Test output
coverage/
.nyc_output/
junit.xml

# Caches
.cache/
.eslintcache
.stylelintcache
.vite/
*.local

# Local database data (if PostgreSQL is ever run with a bind-mounted volume)
pgdata/
postgres-data/

# Editors / IDEs
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.swp
*.swo
*.sublime-workspace

# OS files
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini

# Temporary files
tmp/
temp/
*.tmp

# Local Claude Code settings (per-user, not shared)
.claude/settings.local.json
