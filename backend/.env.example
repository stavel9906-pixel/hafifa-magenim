# Copy to `.env` and fill in real values. `.env` is git-ignored.

NODE_ENV=development
PORT=3001

# Comma-separated frontend origins allowed to call the API and open WebSockets
CORS_ORIGINS=http://localhost:5173

# PostgreSQL connection
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=change-me
DB_NAME=drone_simulation

# Drone generation loop
SIMULATION_ENABLED=true
SIMULATION_INTERVAL_MS=5000
# Only the newest N drones are kept; older ones are deleted
DRONES_MAX_COUNT=20

# IP camera (RTSP). Leave CAMERA_HOST empty to disable the camera stream.
CAMERA_HOST=10.0.10.72
CAMERA_RTSP_PORT=554
CAMERA_STREAM_PATH=stream1
CAMERA_USERNAME=admin
CAMERA_PASSWORD=change-me
# MediaMTX (RTSP -> WebRTC). Full path if mediamtx is not on PATH
MEDIAMTX_PATH=mediamtx
MEDIAMTX_WEBRTC_PORT=8889
