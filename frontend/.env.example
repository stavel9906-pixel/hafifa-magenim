# Copy to `.env` (or `.env.local`) and adjust. Env files are git-ignored.

# Base URL of the backend REST API (includes the /api prefix)
VITE_API_URL=http://localhost:3001/api

# MapLibre style JSON (OpenFreeMap: free, no API key)
VITE_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty

# Backend Socket.IO server (origin only, no /api)
VITE_SOCKET_URL=http://localhost:3001
